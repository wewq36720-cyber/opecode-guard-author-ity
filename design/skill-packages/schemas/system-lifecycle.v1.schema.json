{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode.local/schemas/system-lifecycle.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lifecycle_id", "version", "public_states", "package_contracts", "start", "virtual_nodes", "transitions", "suspensions", "terminal_policies", "sidecars", "acceptance", "unknown_transition_policy"],
  "properties": {
    "schema_version": {"const": "system-lifecycle.v1"},
    "lifecycle_id": {"type": "string"},
    "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "public_states": {"type": "array", "minItems": 5, "items": {"enum": ["PLANNING", "IMPLEMENTING", "VERIFYING", "REVIEW_REQUIRED", "ACCEPTED"]}},
    "package_contracts": {"type": "array", "minItems": 6, "items": {"type": "object", "required": ["package_id", "schema_version", "version"]}},
    "start": {"type": "object", "required": ["node_id", "event_id", "next_step_id", "public_state"]},
    "virtual_nodes": {"type": "array", "items": {"type": "object", "required": ["node_id", "kind", "public_state"]}},
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transition_id", "public_state"],
        "allOf": [
          {
            "oneOf": [
              {"required": ["from_step_id"]},
              {"required": ["from_node_id"]}
            ]
          },
          {
            "oneOf": [
              {"required": ["terminal_outcome"]},
              {"required": ["event_id"]}
            ]
          },
          {
            "oneOf": [
              {"required": ["from_step_id", "terminal_outcome"]},
              {"required": ["from_node_id", "event_id"]}
            ]
          },
          {
            "oneOf": [
              {"required": ["next_step_id"]},
              {"required": ["next_node_id"]}
            ]
          }
        ],
        "properties": {
          "transition_id": {"type": "string"},
          "from_step_id": {"type": "string"},
          "from_node_id": {"type": "string"},
          "terminal_outcome": {"type": "string"},
          "event_id": {"type": "string"},
          "when": {"type": "array", "items": {"type": "object", "required": ["fact_id", "operator", "value"]}},
          "next_step_id": {"type": "string"},
          "next_node_id": {"type": "string"},
          "public_state": {"enum": ["PLANNING", "IMPLEMENTING", "VERIFYING", "REVIEW_REQUIRED", "ACCEPTED"]}
        }
      }
    },
    "suspensions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["suspension_id", "origin_step_id", "terminal_outcome", "question_schema_id", "response_schema_id", "apply_step_id", "apply_terminal_outcome", "resume_step_id", "resume_input_artifact"]}},
    "terminal_policies": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["terminal_outcome", "next_node_id"]}},
    "sidecars": {"type": "array", "items": {"type": "object", "required": ["step_id", "invocation_events", "advances_primary_lifecycle"]}},
    "acceptance": {"type": "object", "required": ["aggregation", "criteria", "self_test_is_acceptance"]},
    "unknown_transition_policy": {"const": "block"}
  }
}
